<!----------------T1087.001--------------------------------------------------------------------------------->

<!-- Basic Rule Detection for Local Enumeration(T1087.001) -- 92033 
<group name="Powershell, Sysmon, suspicious,">
    <rule id="100403" level="13"
    <if_group>sysmon_event1</if_group>

    <field name="win.eventdata.image" type="pcre2">(?i)\b(?:powershell|net|net1)\b(?:\.exe)?</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\b(localgroup|user)\b</field>
    <description>Account Enumeration</description>
    <mitre>
        <id>T1087.001</id>
    </mitre>
    </rule>
</group>

<!-- Advanced(Less false positives) Detection for Local Enumeration(T1087.001) -- 92033 -->
<group name="Powershell, Suspicious,">
  <rule id="100501" level="10">
    <if_sid>92033</if_sid>
        <field name="win.eventdata.image">net.exe</field>
        <field name="win.eventdata.CommandLine" type="pcre2">(?i)\b(?:user|localgroup)\b</field>
        <field name="win.eventdata.CommandLine" type="pcre2">(?i)net\s+user</field>
        <field name="win.eventdata.ParentCommandLine" type="pcre2">(?i)cmdkey(?:\.exe)?\s+/list</field>
        <field name="win.eventdata.parentCommandLine" type="pcre2">(?i)net\+localgroup</field>

    <description>Suspicious Account Discovery - User Enumeration</description>
  <mitre>
      <id>T1087.001</id>
  </mitre> 
  </rule>
</group>

<!-- Advanced(Less False Positives) Detection for Local Enumeration(T1087.001) -- 92027 -->
<group name="Powershell process,">
    <rule id="100502" level="13">
        <if_sid>92027</if_sid>
        <field name="win.eventdata.commandLine" type="pcre2">(?i)net\s+user\s+get(?:\-localuser)?</field>
        <field name="win.eventdata.commandLine" type="pcre2">((?i)cmdkey(?:\.exe)?\s+/list</field>
        <field name="win.eventdata.commandLine" type="pcre2">(?i)get(?:\-localgroup)?\s+net\s+localgroup</field>
        <field name="win.eventdata.image">powershell.exe</field>
        <field name="win.eventdata.parentCommandLine">powershell.exe</field>

        <description>Malicious Enumeration Execution</description>
        <mitre>
            <id>T1087.001</id>
        </mitre>
    </rule>
</group>


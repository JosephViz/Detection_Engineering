<!-- T1053 SCHEDULED TASK/JOB Basic Rule Detection
<group name="Sysmon, ScheduleTask,">
    <rule id="200215" level="8">
        <if_group>sysmon_event1</if_group>
            <field name="win.eventdata.image">powershell.exe</field>
            <field name="win.eventdata.commandLine" type="pcre2">(?i)New\-ScheduledTaskAction</field>
            <field name="win.eventdata.commandLine" type="pcre2">(?i)\\Administrators</field>
            <field name="win.eventdata.commandLine" type="pcre2">(?i)\-Execute</field>
    </rule>
</group>




